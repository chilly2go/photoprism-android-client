<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/focusable_list_item_background"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/import_queue_thumbnail_margin"
    tools:layout_width="100dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:background="@android:color/darker_gray"
        tools:ignore="ContentDescription" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/video_image_view"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_margin="5dp"
        android:alpha="0.75"
        android:background="@drawable/list_item_gallery_media_indicator_background"
        android:padding="4dp"
        app:layout_constraintStart_toStartOf="@id/image_view"
        app:layout_constraintTop_toTopOf="@id/image_view"
        app:srcCompat="@drawable/ic_video"
        app:tint="@android:color/white"
        tools:ignore="ContentDescription" />

    <FrameLayout
        android:id="@+id/badge_layout"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="5dp"
        android:background="@drawable/import_queue_badge_background"
        app:layout_constraintBottom_toBottomOf="@id/image_view"
        app:layout_constraintEnd_toEndOf="@id/image_view"
        tools:backgroundTint="#2E7D32">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/badge_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            app:tint="@android:color/white"
            tools:ignore="ContentDescription"
            tools:srcCompat="@drawable/ic_done" />

    </FrameLayout>

    <!-- Upload progress of the file, over the thumbnail. -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/upload_progress_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/import_queue_badge_background"
        android:backgroundTint="#99000000"
        android:indeterminate="true"
        android:padding="4dp"
        android:visibility="gone"
        app:indicatorColor="@android:color/white"
        app:indicatorSize="36dp"
        app:layout_constraintBottom_toBottomOf="@id/image_view"
        app:layout_constraintEnd_toEndOf="@id/image_view"
        app:layout_constraintStart_toStartOf="@id/image_view"
        app:layout_constraintTop_toTopOf="@id/image_view"
        app:trackColor="#55FFFFFF"
        app:trackThickness="4dp"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
